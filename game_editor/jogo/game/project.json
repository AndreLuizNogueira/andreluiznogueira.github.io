  "strings": {
    "guarda.chave": {
      "en": "Of course. Here is the key. The firewood is next to the fireplace.",
      "pt": "Claro. Aqui está a chave. A lenha fica do lado da lareira."
    },
    "guarda.de_nada": {
      "en": "Don't forget to put out the fire before you sleep.",
      "pt": "Não esqueça de apagar o fogo antes de dormir."
    },
    "guarda.ja_tem": {
      "en": "Thanks for the key!",
      "pt": "Obrigado pela chave!"
    },
    "guarda.nada": {
      "en": "Just passing through.",
      "pt": "Só estou de passagem."
    },
    "guarda.oi": {
      "en": "Good evening! Few people walk this trail after dark. The cabin at the end is mine, but tonight I keep watch out here.",
      "pt": "Boa noite! Pouca gente anda por esta trilha depois que escurece. A cabana lá no fim é minha, mas hoje eu fico de vigia aqui fora."
    },
    "guarda.pedir": {
      "en": "May I rest in the cabin?",
      "pt": "Posso descansar na cabana?"
    },
    "guarda.pergunta": {
      "en": "Can I help?",
      "pt": "Posso ajudar?"
    },
    "guarda.tchau": {
      "en": "Have a good walk, then.",
      "pt": "Boa caminhada, então."
    },
    "nao": {
      "en": "No",
      "pt": "Não"
    },
    "nome.guarda": {
      "en": "Ranger",
      "pt": "Guarda"
    },
    "nome.heroi": {
      "en": "You",
      "pt": "Você"
    },
    "porta.entrar": {
      "en": "Go into the cabin?",
      "pt": "Entrar na cabana?"
    },
    "porta.trancada": {
      "en": "It is locked. Maybe the trail ranger has the key.",
      "pt": "Está trancada. Talvez o guarda da trilha tenha a chave."
    },
    "sim": {
      "en": "Yes",
      "pt": "Sim"
    }
  },
